<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="7dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#111317"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:rippleColor="#33FB720A"
    app:strokeColor="#1FFFFFFF"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Zero-overlap top header row: left badges flex/ellipsize cleanly before time + bookmark -->
        <LinearLayout
            android:id="@+id/topBadgesRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/timeText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/truckChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:background="@drawable/bg_chip_truck"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="138dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:textColor="@color/primary_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Flatbed" />

            <TextView
                android:id="@+id/freshBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_fresh"
                android:maxLines="1"
                android:paddingHorizontal="7dp"
                android:paddingVertical="4dp"
                android:text="@string/badge_fresh"
                android:textColor="#34D399"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/calledBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_called"
                android:maxLines="1"
                android:paddingHorizontal="7dp"
                android:paddingVertical="4dp"
                android:text="@string/badge_called"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/bookmarkButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="☆"
            android:textColor="@color/text_muted"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@id/topBadgesRow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/topBadgesRow" />

        <TextView
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:maxLines="1"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/topBadgesRow"
            app:layout_constraintEnd_toStartOf="@id/bookmarkButton"
            app:layout_constraintTop_toTopOf="@id/topBadgesRow"
            tools:text="6h ago" />

        <ImageView
            android:id="@+id/dotOrigin"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot_origin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBadgesRow" />

        <View
            android:id="@+id/routeLine"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:background="@drawable/route_line"
            app:layout_constraintBottom_toTopOf="@id/dotDestination"
            app:layout_constraintEnd_toEndOf="@id/dotOrigin"
            app:layout_constraintStart_toStartOf="@id/dotOrigin"
            app:layout_constraintTop_toBottomOf="@id/dotOrigin" />

        <ImageView
            android:id="@+id/dotDestination"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot_destination"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/destCity" />

        <TextView
            android:id="@+id/originCity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/dotOrigin"
            app:layout_constraintTop_toTopOf="@id/dotOrigin"
            tools:text="Charlotte" />

        <TextView
            android:id="@+id/originSub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/dotOrigin"
            app:layout_constraintTop_toBottomOf="@id/originCity"
            tools:text="United States" />

        <TextView
            android:id="@+id/destCity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="18dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/dotOrigin"
            app:layout_constraintTop_toBottomOf="@id/originSub"
            tools:text="Houston" />

        <TextView
            android:id="@+id/destSub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/dotOrigin"
            app:layout_constraintTop_toBottomOf="@id/destCity"
            tools:text="United States" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#14FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/destSub" />

        <TextView
            android:id="@+id/weightChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip_neutral"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider"
            tools:text="20 t" />

        <TextView
            android:id="@+id/priceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/primary_accent"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/weightChip"
            app:layout_constraintStart_toEndOf="@id/weightChip"
            app:layout_constraintTop_toTopOf="@id/weightChip"
            tools:text="Ask for price" />

        <TextView
            android:id="@+id/quickContactButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segment_selected"
            android:drawablePadding="5dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/moving_contact"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_phone"
            app:drawableTint="@color/black"
            app:layout_constraintBottom_toBottomOf="@id/weightChip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/weightChip" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
