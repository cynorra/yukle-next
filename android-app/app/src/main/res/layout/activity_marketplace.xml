<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/sv_background">

    <!-- Ultra-clean Quiet Luxury Top Bar -->
    <LinearLayout
        android:id="@+id/topHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/sv_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOADLY"
            android:textColor="@color/sv_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:text="·"
            android:textColor="@color/sv_outline"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/headerSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nakliye &amp; Lojistik"
            android:textColor="@color/sv_on_surface_variant"
            android:textSize="13sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/supportHeaderBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Destek"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_sv_support"
            app:tint="@color/sv_on_surface_variant" />

        <TextView
            android:id="@+id/avatarHeaderBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/sv_circle_primary"
            android:gravity="center"
            android:text="AL"
            android:textColor="@color/sv_on_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/sv_outline_variant" />

    <!-- Fragment Host Container -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- AdMob Adaptive Banner (kept minimal above dock) -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:adSize="BANNER"
        app:adUnitId="ca-app-pub-4674211063760769/6851449147" />

    <!-- Hairline Separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/sv_outline_variant" />

    <!-- Quiet Luxury 5-Tab Bottom Dock -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@color/sv_background"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">

        <!-- Tab 0: İlanlar -->
        <LinearLayout
            android:id="@+id/navExplore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/navExploreIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_sv_truck"
                app:tint="@color/sv_primary" />
            <TextView
                android:id="@+id/navExploreLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="İlanlar"
                android:textColor="@color/sv_primary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 1: İlan Ver -->
        <LinearLayout
            android:id="@+id/navCreate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/navCreateIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_sv_add"
                app:tint="@color/sv_outline" />
            <TextView
                android:id="@+id/navCreateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="İlan Ver"
                android:textColor="@color/sv_outline"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tab 2: Teklifler (with badge) -->
        <LinearLayout
            android:id="@+id/navOffers"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">
            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="24dp">
                <ImageView
                    android:id="@+id/navOffersIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sv_offers"
                    app:tint="@color/sv_outline" />
                <TextView
                    android:id="@+id/navOffersBadge"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/sv_circle_primary"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/sv_on_primary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </FrameLayout>
            <TextView
                android:id="@+id/navOffersLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Teklifler"
                android:textColor="@color/sv_outline"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tab 3: Mesajlar -->
        <LinearLayout
            android:id="@+id/navMessages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/navMessagesIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_sv_chat"
                app:tint="@color/sv_outline" />
            <TextView
                android:id="@+id/navMessagesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Mesajlar"
                android:textColor="@color/sv_outline"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tab 4: Profil -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/navProfileIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_sv_profile"
                app:tint="@color/sv_outline" />
            <TextView
                android:id="@+id/navProfileLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Profil"
                android:textColor="@color/sv_outline"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
