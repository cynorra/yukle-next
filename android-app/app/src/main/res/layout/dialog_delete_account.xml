<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sv_bottom_sheet_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/sv_btn_danger_soft"
            android:gravity="center"
            android:text="⚠"
            android:textColor="@color/sv_error"
            android:textSize="16sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hesabı Kalıcı Olarak Sil"
                android:textColor="@color/sv_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="İki Adımlı Güvenlik &amp; Silme Onayı"
                android:textColor="@color/sv_outline"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/closeDeleteModal"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/sv_on_surface_variant"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Step Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/sv_surface_low_box"
        android:orientation="horizontal"
        android:padding="3dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/sv_segment_active_white"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="1. Risk Analizi"
            android:textColor="@color/sv_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="2. SMS &amp; Güvenlik"
            android:textColor="@color/sv_outline"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Warning Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/sv_btn_danger_soft"
        android:orientation="vertical"
        android:padding="14dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ⓘ  Bu işlem geri alınamaz!"
            android:textColor="@color/sv_error"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Hesabınız, kayıtlı 4 tamamlanan sevk irsaliyesi, ₺1.500.000 tutarındaki taşıma poliçeleri ve tüm e-arşiv belgeleri kalıcı olarak imha edilecektir."
            android:textColor="@color/sv_on_surface"
            android:textSize="12sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/sv_card"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="• Bekleyen Faaliyet: 1 Aktif İlan • 3 Gelen Teklif İptal Olacak"
            android:textColor="@color/sv_error"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- SMS Verification Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="SMS Doğrulama Kodu (+90 532 *** ** 12)"
        android:textColor="@color/sv_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/smsCodeInput"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/sv_input"
        android:fontFamily="monospace"
        android:hint="6 haneli doğrulama kodu (örn: 481920)"
        android:inputType="number"
        android:maxLength="6"
        android:paddingHorizontal="12dp"
        android:textColor="@color/sv_primary"
        android:textSize="14sp" />

    <!-- Final Confirmation Phrase -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Son Onay: 'HESABIMI SİL' yazın (Büyük harflerle)"
        android:textColor="@color/sv_error"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/confirmPhraseInput"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/sv_input"
        android:fontFamily="monospace"
        android:hint="HESABIMI SİL"
        android:singleLine="true"
        android:textColor="@color/sv_primary"
        android:textSize="14sp" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cancelDeleteBtn"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/sv_btn_outline"
            android:gravity="center"
            android:text="Vazgeç"
            android:textColor="@color/sv_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/confirmDeleteBtn"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.3"
            android:layout_marginStart="10dp"
            android:background="@drawable/sv_btn_danger"
            android:gravity="center"
            android:text="🔒 Hesabımı Kalıcı Olarak Sil"
            android:textColor="@color/sv_on_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
