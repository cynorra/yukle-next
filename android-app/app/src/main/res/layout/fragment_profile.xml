<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sv_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Profile Identity Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/sv_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/profileInitials"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/sv_circle_primary"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="AL"
                    android:textColor="@color/sv_on_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/profileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ahmet Levent"
                            android:textColor="@color/sv_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/sv_pill_surface_low"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="Bireysel &amp; Kurumsal"
                            android:textColor="@color/sv_on_surface_variant"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/profileContact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="+90 532 *** ** 12 • ahmet@levent.com"
                        android:textColor="@color/sv_outline"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="●  Kimlik &amp; Vergi No Doğrulandı"
                        android:textColor="@color/sv_emerald"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Guarantee Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/sv_surface_low_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡  Loadly Güvenli Taşıma Garantisi"
                        android:textColor="@color/sv_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tüm taşımalar ₺1.500.000 sigorta teminatı altındadır."
                        android:textColor="@color/sv_on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/guaranteeDetailBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detay"
                    android:textColor="@color/sv_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3 Activity KPI Pods -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/kpiActiveListings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/sv_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="AKTİF İLAN"
                    android:textColor="@color/sv_outline"
                    android:textSize="10sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="1"
                    android:textColor="@color/sv_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Yayında"
                    android:textColor="@color/sv_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/kpiIncomingOffers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/sv_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="GELEN TEKLİF"
                    android:textColor="@color/sv_outline"
                    android:textSize="10sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="3"
                    android:textColor="@color/sv_secondary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="En iyi: ₺24.500"
                    android:textColor="@color/sv_on_surface_variant"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/kpiCompleted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/sv_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="TAMAMLANAN"
                    android:textColor="@color/sv_outline"
                    android:textSize="10sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="4"
                    android:textColor="@color/sv_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ 5.0"
                    android:textColor="@color/sv_emerald"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Group 1: Taşınma & İlan Yönetimi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            android:fontFamily="monospace"
            android:text="TAŞINMA &amp; İLAN YÖNETİMİ"
            android:textColor="@color/sv_outline"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/sv_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/rowActiveListings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aktif İlanlarım" android:textColor="@color/sv_primary" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kadıköy, İstanbul → Çankaya, Ankara (3+1)" android:textColor="@color/sv_outline" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/sv_circle_primary" android:gravity="center" android:text="1" android:textColor="@color/sv_on_primary" android:textSize="10sp" android:fontFamily="monospace" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="›" android:textColor="@color/sv_outline" android:textSize="18sp" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="@color/sv_outline_variant" />

            <LinearLayout
                android:id="@+id/rowPastMoves"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Geçmiş Taşınmalar &amp; Sözleşmeler" android:textColor="@color/sv_primary" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tamamlanmış sevk irsaliyeleri ve dijital nüshalar" android:textColor="@color/sv_outline" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4 Arşiv  ›" android:textColor="@color/sv_outline" android:textSize="11sp" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="@color/sv_outline_variant" />

            <LinearLayout
                android:id="@+id/rowAddresses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kayıtlı Adres Defteri" android:textColor="@color/sv_primary" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ev (Fenerbahçe), Ofis (Maslak), Yazlık (Urla)" android:textColor="@color/sv_outline" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3 Adres  ›" android:textColor="@color/sv_outline" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Group 2: Ödeme & Finansal Güvence -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            android:fontFamily="monospace"
            android:text="ÖDEME &amp; FİNANSAL GÜVENCE"
            android:textColor="@color/sv_outline"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/sv_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/rowEscrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loadly Güvenli Havuz Hesabı" android:textColor="@color/sv_primary" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Teslim onayı verilene dek bloke güvence" android:textColor="@color/sv_outline" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:text="₺0,00  ›" android:textColor="@color/sv_primary" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="@color/sv_outline_variant" />

            <LinearLayout
                android:id="@+id/rowInsurance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eşya &amp; Emtia Sigorta Poliçeleri" android:textColor="@color/sv_primary" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Anadolu Sigorta Entegre Teminat" android:textColor="@color/sv_outline" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/sv_pill_surface_low" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:text="Aktif" android:textColor="@color/sv_primary" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Group 3: Tercihler & Destek -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            android:fontFamily="monospace"
            android:text="TERCİHLER &amp; DESTEK"
            android:textColor="@color/sv_outline"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/sv_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/rowNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bildirim Tercihleri" android:textColor="@color/sv_primary" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/notifStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Anlık İleti &amp; Yeni Teklif Bildirimleri: Açık" android:textColor="@color/sv_outline" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Değiştir" android:textColor="@color/sv_secondary" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="@color/sv_outline_variant" />

            <LinearLayout
                android:id="@+id/rowSupportCall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7/24 VIP Lojistik Destek Hattı" android:textColor="@color/sv_primary" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0850 255 44 00 • Doğrudan Operatör" android:textColor="@color/sv_outline" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/sv_pill_surface_low" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:text="Hemen Ara" android:textColor="@color/sv_secondary" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="@color/sv_outline_variant" />

            <LinearLayout
                android:id="@+id/rowKvkk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hukuki Şartlar &amp; KVKK" android:textColor="@color/sv_primary" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Taşıyıcı sorumluluk protokolü ve gizlilik" android:textColor="@color/sv_outline" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/sv_outline" android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Group 4: Hesap Güvenliği & Veri Yönetimi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            android:fontFamily="monospace"
            android:text="HESAP GÜVENLİĞİ &amp; VERİ YÖNETİMİ"
            android:textColor="@color/sv_outline"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/sv_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/rowClearData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hesap Verilerini Temizle" android:textColor="@color/sv_primary" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Taşıma geçmişi, arama ve taslakları sıfırla" android:textColor="@color/sv_outline" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/sv_outline" android:textSize="18sp" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="@color/sv_outline_variant" />

            <LinearLayout
                android:id="@+id/rowDeleteAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hesabı Kalıcı Olarak Sil" android:textColor="@color/sv_error" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tüm profil, sözleşmeler ve veriler geri alınamaz şekilde silinir" android:textColor="@color/sv_outline" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/sv_error" android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
