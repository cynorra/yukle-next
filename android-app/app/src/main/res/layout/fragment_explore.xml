<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/sv_background">

    <!-- Search Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/sv_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            app:tint="@color/sv_outline" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:hint="Nereden veya nereye taşınma?"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/sv_on_surface"
            android:textColorHint="@color/sv_outline"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/filterBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Filtrele"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_sv_filter"
            app:tint="@color/sv_on_surface_variant" />
    </LinearLayout>

    <!-- Route Quick Chips & Live Count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipQuickRoute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/sv_pill_surface_low"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="● İstanbul ⇄ Ankara"
            android:textColor="@color/sv_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipAllScope"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/sv_pill_white"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="Tüm İlanlar"
            android:textColor="@color/sv_on_surface_variant"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/liveCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Canlı: 142 ilan"
            android:textColor="@color/sv_outline"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Category Filter Pills -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/catAll"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/sv_pill_primary"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Tümü"
                android:textColor="@color/sv_on_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/catHome"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/sv_pill_white"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Evden Eve"
                android:textColor="@color/sv_on_surface_variant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/catOffice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/sv_pill_white"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Ofis &amp; İşyeri"
                android:textColor="@color/sv_on_surface_variant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/catFreight"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/sv_pill_white"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Kurumsal Yük"
                android:textColor="@color/sv_on_surface_variant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/catSaved"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/sv_pill_white"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="★ Kayıtlı"
                android:textColor="@color/sv_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Listings Feed with SwipeRefresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/exploreRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="16dp" />

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/emptyStateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Bu filtreye uygun aktif ilan bulunamadı."
                    android:textColor="@color/sv_on_surface_variant"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/emptyRetryBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/sv_btn_primary"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp"
                    android:text="Filtreleri Sıfırla"
                    android:textColor="@color/sv_on_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
