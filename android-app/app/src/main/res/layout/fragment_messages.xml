<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sv_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Protected Communication Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/sv_surface_low_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/sv_circle_surface"
                android:padding="6dp"
                android:src="@drawable/ic_sv_shield"
                app:tint="@color/sv_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Korumalı İletişim Hattı"
                        android:textColor="@color/sv_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Aktif"
                        android:textColor="@color/sv_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Numaranız gizlenir. Ödeme, sözleşme ve yazışmalar güvence kapsamındadır."
                    android:textColor="@color/sv_on_surface_variant"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Search Messages Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/sv_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                app:tint="@color/sv_outline" />
            <EditText
                android:id="@+id/msgSearchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="Mesajlarda veya firma adında ara..."
                android:singleLine="true"
                android:textColor="@color/sv_on_surface"
                android:textColorHint="@color/sv_outline"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Filter Pills -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/msgFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/sv_pill_primary"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Tümü"
                    android:textColor="@color/sv_on_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/msgFilterActive"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/sv_pill_white"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Aktif İlanlar (2)"
                    android:textColor="@color/sv_on_surface_variant"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/msgFilterSupport"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/sv_pill_white"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Loadly Destek"
                    android:textColor="@color/sv_on_surface_variant"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/msgFilterArchive"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/sv_pill_white"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Arşiv"
                    android:textColor="@color/sv_on_surface_variant"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/msgCountHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="GELEN MESAJLAR (3)"
                android:textColor="@color/sv_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Canlı Senkron"
                android:textColor="@color/sv_outline"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Threads Host -->
        <LinearLayout
            android:id="@+id/threadsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- Guide Footer Tip -->
        <LinearLayout
            android:id="@+id/msgGuideCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/sv_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ℹ  Taşıyıcı teklifini kabul etmeden önce asansör ve kat detaylarını teyit etmeyi unutmayın."
                android:textColor="@color/sv_on_surface_variant"
                android:textSize="12sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Rehber"
                android:textColor="@color/sv_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
