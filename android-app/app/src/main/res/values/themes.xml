<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.Loadly" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_accent</item>
        <item name="colorPrimaryVariant">@color/primary_accent_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/primary_accent</item>
        <item name="colorSecondaryVariant">@color/primary_accent_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <!-- Window background -->
        <item name="android:windowBackground">@color/background_dark</item>
    </style>
    
    <!-- Android 12+ (API 31+) shows its own system splash screen before any Activity
         code runs, using this theme's windowSplashScreen* attrs - without this, the
         OS falls back to a heuristic (usually the launcher icon on a plain background)
         that doesn't match our branded dark splash, causing a jarring flash/color-jump
         right before SplashActivity's own content (same background + logo) takes over.
         On API <31, core-splashscreen makes installSplashScreen() a no-op and this
         theme behaves like a plain windowBackground, so behavior there is unchanged. -->
    <style name="Theme.Loadly.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/brand_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Loadly.Splash.Post</item>
    </style>

    <style name="Theme.Loadly.Splash.Post" parent="Theme.Loadly">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>