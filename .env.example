# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Site
NEXT_PUBLIC_SITE_URL=https://loadlyapp.com

# Scraper Config
# The profile UUID that will own all imported loads
SCRAPER_SHIPPER_ID=

# Firebase Cloud Messaging - pushes "new load" notifications to the Android app's
# per-country "new_loads_{ISO2}" topics. Firebase Console -> Project Settings ->
# Service Accounts -> Generate new private key. Paste the whole downloaded JSON
# file as one line here. Feature no-ops (skips sending, no error) until this is set.
FIREBASE_SERVICE_ACCOUNT=

# Shared secret the scraper (GitHub Actions) sends as a Bearer token when calling
# /api/webhooks/fcm-batch after each run. Also needed as a GitHub repo secret
# (Settings -> Secrets and variables -> Actions) with the same value.
SCRAPER_WEBHOOK_SECRET=

# Shared secret the blog-generator cron sends when calling /api/_revalidate right
# after publishing, so the new post shows up without waiting for time-based ISR.
# Also needed as a GitHub repo secret (same value) for blog-generator.yml.
REVALIDATE_SECRET=

# Web Push (browser notifications, unrelated to the above)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

